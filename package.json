{
  "name": "dsh-multi-workspace",
  "version": "0.5.3",
  "type": "module",
  "description": "Give a DSH agent extra writable roots, then see the proof: per-root read/write/delete/move bits, a sensitive-file deny list, and a JSONL audit trail you can read as plain-language trust summaries.",
  "license": "MIT",
  "author": "David-Martinez-worldexecute",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "sandbox",
    "workspace",
    "writable-roots",
    "agent-safety",
    "audit",
    "permissions"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/David-Martinez-worldexecute/dsh-multi-workspace.git"
  },
  "homepage": "https://github.com/David-Martinez-worldexecute/dsh-multi-workspace#readme",
  "bugs": {
    "url": "https://github.com/David-Martinez-worldexecute/dsh-multi-workspace/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "lib/",
    "bin/",
    "panel/",
    "icon.svg",
    "docs/",
    "cordis.patch.yml",
    "README.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "边界与自检.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node tests/run-all.mjs",
    "check": "node tests/run-all.mjs && node scripts/load-check.mjs",
    "load-check": "node scripts/load-check.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.2.2-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
